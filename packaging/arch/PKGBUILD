# Maintainer: Aleblazer <spenceizzle at gmail dot com>
# PKGBUILD for fadewire-git (AUR). A fixed-release `fadewire` package follows
# once the first tagged release exists (then build with `--locked` against the
# committed Cargo.lock).

pkgname=fadewire-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Hardware & virtual fader mixer for PipeWire — per-app volume control with real sliders"
arch=('x86_64' 'aarch64')
url="https://github.com/Aleblazer/fadewire"
license=('MIT')
depends=('gcc-libs' 'libpulse' 'pipewire' 'systemd-libs')
makedepends=('cargo' 'git')
provides=('fadewire')
conflicts=('fadewire')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --workspace
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/fadewired "$pkgdir/usr/bin/fadewired"
  install -Dm755 target/release/fadewire "$pkgdir/usr/bin/fadewire"

  # udev: unprivileged hidraw access to the fader device. The systemd package
  # ships a pacman hook that reloads udev rules on install.
  install -Dm644 packaging/udev/70-fadewire.rules \
    "$pkgdir/usr/lib/udev/rules.d/70-fadewire.rules"

  # systemd user unit: enable with `systemctl --user enable --now fadewire`.
  install -Dm644 packaging/systemd/fadewire.service \
    "$pkgdir/usr/lib/systemd/user/fadewire.service"

  install -Dm644 docs/config.example.toml \
    "$pkgdir/usr/share/doc/fadewire/config.example.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/fadewire/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/fadewire/LICENSE"
}
